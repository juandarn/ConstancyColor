  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "REGLAS DEL EXPERIMENTO\r\n\r\n\u2022 Mantente sentado o de pie en una
    posici\xF3n c\xF3moda y estable.\r\n\u2022 No muevas objetos de la escena; usa
    solo el panel de ajustes.\r\n\u2022 Ajusta BRILLO, MODO (Temperatura/Color) y
    COLOR cuando se te indique.\r\n\u2022 Distancia recomendada: 1\u20131.5 m frente
    al panel y la referencia.\r\n\r\nCONTROLES (Rift/Touch)\r\n\u2022 Gatillo (Trigger
    \u2013 dedo \xEDndice): Seleccionar/click en botones, toggles y sliders del panel.\r\n\u2022
    Bot\xF3n lateral (Grip \u2013 costado del mando, dedos medio/anular): Agarrar
    la BARREA SUPERIOR del panel para moverlo. Mant\xE9n Grip y mueve el mando; suelta
    para dejarlo fijo.\r\n\u2022 (Opcional en tu escena) Thumbstick: usa solo si
    est\xE1 habilitado para locomoci\xF3n.\r\n\r\nSEGURIDAD\r\n\u2022 Si sientes
    mareo o incomodidad, qu\xEDtate el visor y avisa de inmediato.\r\n\r\nCuando
    termines de leer, pulsa \u201CHe le\xEDdo / Continuar\u201D.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
